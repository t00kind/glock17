# ─── MAX ────────────────────────────────────────────────────────────
MAX_BOT_TOKEN=your_max_bot_token
MAX_CHAT_ID=your_numeric_chat_id

# ─── Одноклассники ──────────────────────────────────────────────────
OK_APP_ID=your_ok_app_id
OK_APP_KEY=your_ok_application_key
OK_APP_SECRET=your_ok_application_secret_key
OK_ACCESS_TOKEN=your_ok_access_token
OK_GROUP_ID=your_ok_group_id

# ─── ВКонтакте ──────────────────────────────────────────────────────
# Вариант 1 — ключ доступа сообщества: настройки группы → Работа с API.
# Не протухает, но фотографии на стену им не публикуются: ВК отвечает
# ошибкой 27 (известное ограничение, github.com/VKCOM/vk-api-schema/issues/242).
# Годится, если в ВК достаточно текста.
#
# Вариант 2 — пользовательский токен из мини-приложения (docs/index.html,
# VK Bridge). Фотографии публикуются штатно, но токен живёт около суток,
# после чего страницу нужно открыть заново.
#
# Токены VK ID (vk2.a.*) НЕ подходят ни там, ни там — они только для входа
# на сайты, методы API отвечают на них ошибками 1051 и 15.
VK_ACCESS_TOKEN=your_vk_access_token
# Для автообновления протухшего токена VK ID (токен живёт ~час).
# Без них бот остановится на ошибке авторизации через час после старта.
VK_REFRESH_TOKEN=your_vk_refresh_token
VK_APP_ID=your_vk_id_app_id
VK_DEVICE_ID=your_vk_device_id
# Хостинг без консоли: вместо VK_ACCESS_TOKEN задайте код и verifier — бот сам
# обменяет их на токены при старте (python get_vk_token.py <APP_ID> --for-server).
# ВК привязывает токен к IP того, кто делает обмен, поэтому его должен делать бот.
# Код одноразовый: после успешного старта переменные можно убрать.
VK_AUTH_CODE=
VK_CODE_VERIFIER=
VK_REDIRECT_URI=https://oauth.vk.com/blank.html
# Запросов в секунду к VK API (лимит ВК для пользовательского токена — 3)
VK_RATE_LIMIT=3
# Числовой ID сообщества (без минуса)
VK_GROUP_ID=your_vk_group_id
VK_API_VERSION=5.199

# ─── Поведение (опционально) ────────────────────────────────────────
# Куда постить при запуске через app/main.py:
#   ok  - только Одноклассники (значение по умолчанию, если переменная не задана)
#   vk  - только ВКонтакте
#   all - обе площадки сразу, в одном процессе (нужны токены и ОК, и ВК)
CROSSPOST_TARGET=vk
# Уровень логов: INFO (прод) или DEBUG (отладка — пишет RAW-тела и ответы API)
LOG_LEVEL=INFO
# Каталог для состояния (posted_ids*.json, marker*.txt, crosspost*.log).
# В Docker сюда монтируется volume.
STATE_DIR=.
# Бэкфилл при пустом состоянии: 0 = не заливать старые посты (по умолчанию), 1 = залить
BACKFILL_ON_EMPTY=0
# Ручной бэкфилл: eboi=true — при КАЖДОМ старте залить последние BACKFILL_COUNT
# постов канала (уже перенесённые отсеются по posted_ids, дублей не будет).
# Включил → перезапустил → выключил обратно.
eboi=false
# Сколько последних постов залить, если бэкфилл включён
BACKFILL_COUNT=3
# Перезалить посты, даже если они уже переносились: vk | ok | all.
# Нужно, когда пост уехал битым (например, без части фотографий), а доступа
# к файлам состояния на хостинге нет. Осторожно: создаёт дубли.
BACKFILL_IGNORE_POSTED=
